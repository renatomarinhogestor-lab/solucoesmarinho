    // ==============================
    const WHATSAPP_NUMBER = "5567999076005";
    const APPS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbyfmsAAFsKwUM-ytPhuVIeqDdxpWl_FghqlNA9mGzsU8QacM4d_6ofcIZEXE9AOcfxI/exec";

    const dataLayer = window.dataLayer = window.dataLayer || [];

    function track(eventName, extra = {}) {
      dataLayer.push({ event: eventName, ...extra });
    }

    document.querySelectorAll("[data-track]").forEach((element) => {
      element.addEventListener("click", () => {
        track("cta_click", { cta_name: element.dataset.track });
      });
    });

    const params = new URLSearchParams(window.location.search);
    const attribution = {
      utm_source: params.get("utm_source") || "",
      utm_medium: params.get("utm_medium") || "",
      utm_campaign: params.get("utm_campaign") || "",
      utm_term: params.get("utm_term") || "",
      utm_content: params.get("utm_content") || "",
      gclid: params.get("gclid") || ""
    };

    const form = document.getElementById("leadForm");
    const statusMessage = document.getElementById("statusMessage");

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      statusMessage.style.display = "none";

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      if (!/^\d{12,15}$/.test(WHATSAPP_NUMBER)) {
        statusMessage.textContent = "O número do WhatsApp ainda não foi configurado corretamente.";
        statusMessage.style.display = "block";
        return;
      }

      const fields = new FormData(form);

      // Campo invisível anti-spam. Visitantes reais não o preenchem.
      if (fields.get("website_check")) {
        return;
      }

      const payload = new URLSearchParams({
        nome: fields.get("nome") || "",
        empresa: fields.get("empresa") || "",
        email: fields.get("email") || "",
        site: fields.get("site") || "",
        canal: fields.get("canal") || "",
        verba: fields.get("verba") || "",
        objetivo: fields.get("objetivo") || "",
        utm_source: attribution.utm_source,
        utm_medium: attribution.utm_medium,
        utm_campaign: attribution.utm_campaign,
        utm_term: attribution.utm_term,
        utm_content: attribution.utm_content,
        gclid: attribution.gclid,
        pagina: window.location.href.split("#")[0],
        lp_origem: "consultoria-google-ads",
        website_check: ""
      });

      const submitButton = form.querySelector('button[type="submit"]');
      const originalText = submitButton.textContent;
      submitButton.disabled = true;
      submitButton.textContent = "Registrando informações...";

      track("generate_lead", {
        form_name: "consultoria_google_ads",
        monthly_budget: fields.get("verba"),
        current_channel: fields.get("canal")
      });

      fetch(APPS_SCRIPT_URL, {
          method: "POST",
          mode: "no-cors",
          headers: {
            "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8"
          },
          body: payload.toString(),
          keepalive: true
        }).catch((error) => {
          console.error("Falha ao registrar o lead na planilha:", error);
        });

      const whatsappMessage =
        "Olá, Renato! Vim pela página de consultoria Google Ads e gostaria de conversar sobre a análise da minha conta.";

      const whatsappUrl =
        `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(whatsappMessage)}`;

      submitButton.textContent = originalText;
      submitButton.disabled = false;

      window.location.href = whatsappUrl;
    });

    document.getElementById("year").textContent = new Date().getFullYear();
  </script>
</body>
</html>
