  <link rel="canonical" href="https://solucoesmarinho.com.br/servicos/consultoria-google-ads">
  <style>
    :root {
      --bg: #07111f;
      --bg-soft: #0b1728;
      --panel: rgba(255,255,255,.055);
      --panel-strong: rgba(255,255,255,.085);
      --text: #f5f8ff;
      --muted: #e2e9f3;
      --line: rgba(255,255,255,.12);
      --primary: #6d8cff;
      --primary-strong: #4c6fff;
      --secondary: #68e0c1;
      --warning: #ffd37a;
      --shadow: 0 24px 70px rgba(0,0,0,.35);
      --radius: 22px;
      --radius-sm: 14px;
      --max: 1160px;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      color: var(--text);
      background:
        radial-gradient(circle at 18% -5%, rgba(109,140,255,.22), transparent 34%),
        radial-gradient(circle at 90% 10%, rgba(104,224,193,.13), transparent 28%),
        var(--bg);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
    }

    a { color: inherit; text-decoration: none; }
    button, input, select, textarea { font: inherit; }
    img { max-width: 100%; display: block; }
    section { scroll-margin-top: 88px; }

    .container { width: min(calc(100% - 36px), var(--max)); margin-inline: auto; }
    .skip-link {
      position: fixed; left: 16px; top: -80px; z-index: 999;
      background: #fff; color: #111; padding: 12px 16px; border-radius: 10px;
    }
    .skip-link:focus { top: 16px; }

    .site-header {
      position: sticky; top: 0; z-index: 50;
      backdrop-filter: blur(18px);
      background: rgba(7,17,31,.76);
      border-bottom: 1px solid rgba(255,255,255,.08);
    }
    .nav {
      min-height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 24px;
    }
    .brand { display: inline-flex; align-items: center; gap: 11px; font-weight: 800; letter-spacing: -.02em; }
    .brand-mark {
      width: 38px; height: 38px; display: grid; place-items: center;
      border-radius: 12px; color: #07111f; font-weight: 900;
      background: linear-gradient(135deg, var(--secondary), #eefcff);
      box-shadow: 0 10px 30px rgba(104,224,193,.18);
    }
    .brand small { display: block; color: var(--muted); font-size: 11px; font-weight: 650; letter-spacing: .08em; text-transform: uppercase; }
    .nav-links { display: flex; align-items: center; gap: 24px; color: var(--muted); font-size: 14px; }
    .nav-links a:hover { color: var(--text); }
    .nav-cta { padding: 10px 16px; border: 1px solid rgba(109,140,255,.5); border-radius: 999px; color: #fff !important; background: rgba(109,140,255,.12); }

    .hero { padding: 88px 0 64px; overflow: hidden; }
    .hero-grid { display: grid; grid-template-columns: 1.12fr .88fr; gap: 54px; align-items: center; }
    .eyebrow {
      display: inline-flex; align-items: center; gap: 9px; padding: 8px 12px;
      border: 1px solid rgba(104,224,193,.28); border-radius: 999px;
      color: #c9fff1; background: rgba(104,224,193,.075);
      font-size: 12px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase;
    }
    .eyebrow::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--secondary); box-shadow: 0 0 0 5px rgba(104,224,193,.1); }
    h1, h2, h3 { margin-top: 0; line-height: 1.08; letter-spacing: -.035em; }
    h1 { margin: 20px 0; font-size: clamp(44px, 6.4vw, 78px); max-width: 860px; }
    h1 span { color: #ffffff; }
    .hero-copy > p { max-width: 720px; margin: 0; color: var(--muted); font-size: clamp(18px, 2.1vw, 21px); }
    .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
    .button {
      min-height: 52px; display: inline-flex; align-items: center; justify-content: center; gap: 9px;
      border-radius: 14px; padding: 0 21px; border: 1px solid transparent;
      font-weight: 800; cursor: pointer; transition: transform .2s ease, background .2s ease, border-color .2s ease;
    }
    .button:hover { transform: translateY(-2px); }
    .button-primary {
      color: #fff; background: linear-gradient(135deg, var(--primary), var(--primary-strong));
      box-shadow: 0 16px 36px rgba(76,111,255,.26);
    }
    .button-secondary { color: var(--text); border-color: var(--line); background: rgba(255,255,255,.035); }
    .button-full { width: 100%; }
    .hero-note { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 18px; color: #f0f4f9; font-size: 13px; }
    .hero-note span::before { content: "✓"; color: var(--secondary); font-weight: 900; margin-right: 7px; }

    .hero-card {
      position: relative; padding: 24px; border: 1px solid var(--line); border-radius: 28px;
      background: linear-gradient(180deg, rgba(255,255,255,.09), rgba(255,255,255,.035));
      box-shadow: var(--shadow);
    }
    .hero-card::before {
      content: ""; position: absolute; inset: -1px; z-index: -1; border-radius: inherit;
      background: linear-gradient(135deg, rgba(109,140,255,.45), transparent 38%, rgba(104,224,193,.25));
      filter: blur(22px); opacity: .35;
    }
    .analysis-label { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .1em; font-weight: 800; }
    .analysis-title { margin: 8px 0 18px; font-size: 24px; }
    .analysis-list { display: grid; gap: 10px; }
    .analysis-item {
      display: grid; grid-template-columns: 34px 1fr; gap: 12px; align-items: start;
      padding: 13px; border-radius: var(--radius-sm); background: rgba(5,12,23,.52); border: 1px solid rgba(255,255,255,.075);
    }
    .analysis-icon {
      width: 34px; height: 34px; display: grid; place-items: center;
      border-radius: 10px; background: rgba(109,140,255,.15); color: #cbd5ff; font-weight: 900;
    }
    .analysis-item strong { display: block; font-size: 14px; }
    .analysis-item small { color: var(--muted); }
    .mini-profile {
      display: flex; align-items: center; gap: 12px; margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--line);
    }
    .avatar {
      flex: 0 0 auto; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center;
      color: #07111f; background: linear-gradient(135deg, #fff, var(--secondary)); font-weight: 900;
    }
    .mini-profile strong { display: block; }
    .mini-profile small { color: var(--muted); }

    .trust-strip { padding: 10px 0 74px; }
    .trust-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
    .trust-item {
      min-height: 92px; padding: 18px; border-radius: 16px; border: 1px solid var(--line);
      background: rgba(255,255,255,.035);
    }
    .trust-item strong { display: block; margin-bottom: 3px; font-size: 15px; }
    .trust-item span { color: var(--muted); font-size: 13px; }

    .section { padding: 92px 0; }
    .section-soft { background: linear-gradient(180deg, rgba(255,255,255,.018), rgba(255,255,255,.04), rgba(255,255,255,.018)); border-block: 1px solid rgba(255,255,255,.055); }
    .section-header { max-width: 760px; margin-bottom: 38px; }
    .kicker { color: var(--secondary); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; font-weight: 850; }
    h2 { margin-bottom: 16px; font-size: clamp(34px, 4.6vw, 56px); }
    .section-header p { margin: 0; color: var(--muted); font-size: 18px; }

    .problem-grid, .service-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .card {
      padding: 24px; border: 1px solid var(--line); border-radius: var(--radius);
      background: var(--panel);
    }
    .card-number { color: #9eb0ff; font-weight: 900; font-size: 13px; }
    .card h3 { margin: 13px 0 9px; font-size: 21px; }
    .card p { margin: 0; color: var(--muted); }
    .card:hover { background: var(--panel-strong); border-color: rgba(109,140,255,.3); }

    .method-wrap { display: grid; grid-template-columns: .78fr 1.22fr; gap: 48px; align-items: start; }
    .sticky-copy { position: sticky; top: 112px; }
    .method-list { display: grid; gap: 15px; }
    .method-step {
      display: grid; grid-template-columns: 58px 1fr; gap: 18px; padding: 25px;
      border-radius: var(--radius); border: 1px solid var(--line); background: rgba(255,255,255,.035);
    }
    .step-index {
      width: 58px; height: 58px; display: grid; place-items: center; border-radius: 18px;
      background: linear-gradient(135deg, rgba(109,140,255,.25), rgba(104,224,193,.12));
      color: #dce3ff; font-size: 18px; font-weight: 900;
    }
    .method-step h3 { margin: 3px 0 8px; font-size: 23px; }
    .method-step p { margin: 0; color: var(--muted); }

    .service-card ul, .qualification-card ul {
      list-style: none; padding: 0; margin: 16px 0 0; display: grid; gap: 10px; color: var(--muted);
    }
    .service-card li, .qualification-card li { position: relative; padding-left: 22px; }
    .service-card li::before, .qualification-card li::before {
      content: "✓"; position: absolute; left: 0; top: 0; color: var(--secondary); font-weight: 900;
    }

    .diagnostic {
      display: grid; grid-template-columns: 1fr .92fr; gap: 30px; padding: 34px;
      border-radius: 30px; border: 1px solid rgba(109,140,255,.26);
      background:
        linear-gradient(135deg, rgba(109,140,255,.14), transparent 45%),
        rgba(255,255,255,.045);
      box-shadow: var(--shadow);
    }
    .diagnostic h2 { font-size: clamp(32px, 4.5vw, 52px); }
    .diagnostic p { color: var(--muted); font-size: 17px; }
    .checklist { display: grid; gap: 11px; }
    .check {
      display: flex; gap: 10px; align-items: flex-start; padding: 13px 15px;
      border-radius: 14px; background: rgba(4,10,18,.4); border: 1px solid rgba(255,255,255,.07);
    }
    .check b { color: var(--secondary); }

    .qualification-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    .qualification-card.good { border-color: rgba(104,224,193,.25); }
    .qualification-card.bad { border-color: rgba(255,211,122,.2); }
    .qualification-card.bad li::before { content: "—"; color: var(--warning); }

    .pricing {
      display: grid; grid-template-columns: 1fr .72fr; gap: 30px; align-items: center;
      padding: 34px; border-radius: 28px; border: 1px solid var(--line); background: rgba(255,255,255,.045);
    }
    .price { font-size: clamp(44px, 6vw, 70px); font-weight: 900; letter-spacing: -.05em; }
    .price small { display: block; color: var(--muted); font-size: 14px; letter-spacing: 0; font-weight: 650; }
    .pricing p { color: var(--muted); }
    .pricing-note { padding: 18px; border-radius: 16px; background: rgba(104,224,193,.07); border: 1px solid rgba(104,224,193,.17); color: #d6fff5; }

    .faq { display: grid; gap: 10px; max-width: 900px; }
    details {
      border: 1px solid var(--line); border-radius: 16px; background: rgba(255,255,255,.035); overflow: hidden;
    }
    summary { cursor: pointer; padding: 20px 22px; font-weight: 800; list-style: none; }
    summary::-webkit-details-marker { display: none; }
    summary::after { content: "+"; float: right; color: var(--secondary); font-size: 22px; line-height: 1; }
    details[open] summary::after { content: "–"; }
    details p { margin: 0; padding: 0 22px 22px; color: var(--muted); }

    .contact-grid { display: grid; grid-template-columns: .82fr 1.18fr; gap: 34px; align-items: start; }
    .contact-copy { padding-top: 12px; }
    .contact-copy p { color: var(--muted); font-size: 17px; }
    .contact-list { display: grid; gap: 12px; margin-top: 24px; }
    .contact-list div { display: flex; gap: 10px; color: #d9e2ef; }
    .contact-list b { color: var(--secondary); }
    .lead-form {
      padding: 26px; border-radius: 26px; border: 1px solid var(--line); background: rgba(255,255,255,.055); box-shadow: var(--shadow);
    }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .field { display: grid; gap: 7px; }
    .field-full { grid-column: 1 / -1; }
    label { color: #ffffff; font-size: 13px; font-weight: 750; }
    input, select, textarea {
      width: 100%; color: var(--text); background: rgba(4,10,18,.62);
      border: 1px solid rgba(255,255,255,.13); border-radius: 12px; padding: 13px 14px; outline: none;
    }
    input:focus, select:focus, textarea:focus { border-color: var(--primary); box-shadow: 0 0 0 4px rgba(109,140,255,.11); }
    select option { color: #111; }
    textarea { resize: vertical; min-height: 105px; }
    .consent { display: flex; align-items: flex-start; gap: 9px; color: var(--muted); font-size: 12px; margin: 14px 0; }
    .consent input { width: auto; margin-top: 3px; }
    .form-note { margin: 12px 0 0; text-align: center; color: var(--muted); font-size: 12px; }
    .hp-field {
      position: absolute !important;
      left: -9999px !important;
      width: 1px !important;
      height: 1px !important;
      overflow: hidden !important;
      opacity: 0 !important;
      pointer-events: none !important;
    }
    .status-message { display: none; margin-top: 12px; padding: 12px; border-radius: 12px; background: rgba(255,211,122,.08); color: #ffe4aa; font-size: 13px; }

    footer { padding: 32px 0 96px; border-top: 1px solid rgba(255,255,255,.08); color: var(--muted); font-size: 13px; }
    .footer-grid { display: flex; justify-content: space-between; gap: 24px; align-items: center; }
    .footer-links { display: flex; gap: 18px; flex-wrap: wrap; }
    .disclaimer { max-width: 820px; margin-top: 18px; font-size: 11px; color: #c9d3e0; }

    .mobile-bar {
      display: none; position: fixed; z-index: 60; left: 12px; right: 12px; bottom: 12px;
      padding: 10px; border: 1px solid rgba(255,255,255,.14); border-radius: 17px;
      background: rgba(7,17,31,.9); backdrop-filter: blur(18px); box-shadow: var(--shadow);
    }
    .mobile-bar .button { width: 100%; min-height: 48px; }


    .consulting-delivery {
      display: grid;
      grid-template-columns: .92fr 1.08fr;
      gap: 34px;
      align-items: center;
    }

    .delivery-copy p {
      color: var(--muted);
      font-size: 17px;
    }

    .deliverable-list {
      display: grid;
      gap: 12px;
      margin-top: 24px;
    }

    .deliverable {
      display: grid;
      grid-template-columns: 42px 1fr;
      gap: 13px;
      padding: 15px;
      border: 1px solid var(--line);
      border-radius: 15px;
      background: rgba(255,255,255,.035);
    }

    .deliverable-index {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  font-weight: 900;
  font-size: 14px;

  color: #07111f !important;
  background: #8ff0d7;

  border: 1px solid rgba(7, 17, 31, 0.12);
}

    .deliverable strong {
      display: block;
      margin-bottom: 3px;
    }

    .deliverable span {
      color: var(--muted);
      font-size: 14px;
    }

    .consulting-visual {
      padding: 12px;
      border-radius: 24px;
      border: 1px solid var(--line);
      background: rgba(255,255,255,.045);
      box-shadow: var(--shadow);
    }

    .consulting-visual img {
      width: 100%;
      height: auto;
      border-radius: 16px;
    }

    .visual-caption {
      padding: 11px 5px 2px;
      color: var(--muted);
      font-size: 12px;
      text-align: center;
    }

    .process-flow {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 10px;
      margin-top: 34px;
      position: relative;
    }

    .process-step {
      position: relative;
      min-height: 150px;
      padding: 20px 17px;
      border: 1px solid var(--line);
      border-radius: 18px;
      background: rgba(255,255,255,.035);
    }

    .process-step:not(:last-child)::after {
      content: "→";
      position: absolute;
      right: -11px;
      top: 50%;
      transform: translateY(-50%);
      z-index: 2;
      width: 22px;
      height: 22px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      color: var(--secondary);
      background: var(--bg);
      font-weight: 900;
    }

    .process-number {
      color: var(--secondary);
      font-size: 12px;
      font-weight: 900;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .process-step h3 {
      margin: 10px 0 7px;
      font-size: 18px;
    }

    .process-step p {
      margin: 0;
      color: var(--muted);
      font-size: 13px;
    }

    .analysis-showcase {
      display: grid;
      grid-template-columns: 1.04fr .96fr;
      gap: 34px;
      align-items: center;
    }

    .analysis-showcase-copy p {
      color: var(--muted);
      font-size: 17px;
    }

    .analysis-bullets {
      display: grid;
      gap: 11px;
      margin-top: 20px;
    }

    .analysis-bullets div {
      padding: 13px 15px;
      border-radius: 14px;
      background: rgba(255,255,255,.035);
      border: 1px solid var(--line);
      color: #eef4fb;
    }

    .analysis-bullets b {
      color: var(--secondary);
      margin-right: 8px;
    }

    .consulting-investment {
      display: grid;
      grid-template-columns: 1fr .82fr;
      gap: 28px;
      align-items: center;
      padding: 34px;
      border-radius: 28px;
      border: 1px solid var(--line);
      background: rgba(255,255,255,.045);
    }

    .consulting-investment p {
      color: var(--muted);
    }

    .scope-card {
      padding: 22px;
      border-radius: 18px;
      border: 1px solid rgba(104,224,193,.22);
      background: rgba(104,224,193,.065);
    }

    .scope-card strong {
      display: block;
      color: #ffffff;
      font-size: 20px;
      margin-bottom: 7px;
    }

    .scope-card span {
      color: #d8fff5;
      font-size: 14px;
    }

    @media (max-width: 920px) {
      .consulting-delivery, .analysis-showcase, .consulting-investment { grid-template-columns: 1fr; }
      .process-flow { grid-template-columns: 1fr 1fr; }
      .process-step:not(:last-child)::after { display: none; }
      .nav-links a:not(.nav-cta) { display: none; }
      .hero-grid, .method-wrap, .diagnostic, .pricing, .contact-grid { grid-template-columns: 1fr; }
      .hero { padding-top: 62px; }
      .hero-card { max-width: 660px; }
      .trust-grid { grid-template-columns: 1fr 1fr; }
      .problem-grid, .service-grid { grid-template-columns: 1fr 1fr; }
      .sticky-copy { position: static; }
      .pricing { align-items: start; }
    }

    @media (max-width: 640px) {
      .container { width: min(calc(100% - 24px), var(--max)); }
      .site-header .nav { min-height: 64px; }
      .brand small { display: none; }
      .nav-cta { padding: 9px 12px; font-size: 13px; }
      .hero { padding: 52px 0 44px; }
      h1 { font-size: clamp(40px, 12vw, 58px); }
      .hero-actions { display: grid; }
      .button { width: 100%; }
      .process-flow { grid-template-columns: 1fr; }
      .trust-grid, .problem-grid, .service-grid, .qualification-grid, .form-grid { grid-template-columns: 1fr; }
      .field-full { grid-column: auto; }
      .section { padding: 68px 0; }
      .diagnostic, .pricing, .lead-form { padding: 22px; }
      .method-step { grid-template-columns: 48px 1fr; padding: 20px; }
      .step-index { width: 48px; height: 48px; border-radius: 14px; }
      .footer-grid { align-items: flex-start; flex-direction: column; }
      .mobile-bar { display: block; }
      footer { padding-bottom: 112px; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after { transition: none !important; animation: none !important; }
    }
  </style>

